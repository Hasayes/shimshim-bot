# Copy to .env for local testing:  cp .env.example .env  then fill in.
# Load before running:  set -a; source .env; set +a; python3 shimshim_bot.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEWS_API_KEY=
ANTHROPIC_API_KEY=
NEWS_PROVIDER=newsdata
NEWSDATA_PAGES=1
# Accuracy pipeline: Haiku classify → web-verify news cards → free oracle gate.
CLASSIFY_MODEL=claude-haiku-4-5
CLAUDE_MODEL=claude-sonnet-4-6
VERIFY_NEWS=1
VERIFY_INTEREST=1
SKIP_VERIFY_TELEGRAM=1
CROSS_CHECK=0
WEB_SEARCH_MAX_USES=3
ORACLE_SANITY=1
# Max chars of article text sent to Claude (Telegram posts / long blurbs).
ARTICLE_TEXT_MAX=1200
# Interest cards older than this are dropped from the live feed (default 7).
MAX_RUMOUR_AGE_DAYS=7
# Journalists to follow. newsdata.io free tier caps this at 100 chars, so use
# surnames for all but Romano. Leave unset to use the built-in default.
NEWS_QUERY="Fabrizio Romano" OR Ornstein OR "Di Marzio" OR Moretto OR Amoyal OR Plettenberg
